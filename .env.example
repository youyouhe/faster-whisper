# API Key Configuration for ASR Services
# Set a secure API key to protect your ASR services
# If not set, services will be open to all requests (not recommended for production)

API_KEY=your-secret-api-key-here

# Generate a secure API key with:
# openssl rand -hex 32
# or
# python3 -c "import secrets; print(secrets.token_hex(32))"

# Example secure API key:
# API_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456
# Subtitle segmentation (shared by whisper + qwen backends, see subtitle_splitter.py)
# Display-width cap per subtitle block: CJK char = 1, ASCII/space = 0.5
# (so ~15 Chinese chars / ~30 English chars per line). Hard flush at cap+5.
#MAX_CHARS_PER_SEGMENT=15
