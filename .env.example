# API Key Configuration for ASR Services
# Set a secure API key to protect your ASR services
# If not set, services will be open to all requests (not recommended for production)

API_KEY=your-secret-api-key-here

# Generate a secure API key with:
# openssl rand -hex 32
# or
# python3 -c "import secrets; print(secrets.token_hex(32))"

# Example secure API key:
# API_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456