# Enhanced Audio Splitter Configuration
# 增强音频分割器配置文件

# 启用增强的音频分割器 (使用VAD和智能分割点选择)
# true: 使用增强分割器（推荐）
# false: 使用标准分割器
USE_ENHANCED_SPLITTER=true

# 分布式处理阈值 (MB)
# 超过此大小的文件将进行分布式处理
DISTRIBUTED_THRESHOLD_MB=10

# 最小分片大小 (MB)
# 每个分片的最小大小，避免分片过小
MIN_CHUNK_SIZE_MB=1.0

# 重叠时间 (秒)
# 分片之间的重叠时间，用于避免切词语
OVERLAP_SECONDS=0.0

# 最大并发分布式任务数
# 同时运行的分布式处理任务数量限制
MAX_CONCURRENT_DISTRIBUTED=3

# VAD配置
# 最小静音段长度 (毫秒)
MIN_SILENCE_DURATION_MS=500

# 最大语音段长度 (秒)
MAX_SPEECH_DURATION_S=30

# 音频处理配置
# 采样率 (Hz)
SAMPLING_RATE=16000

# 位深度 (bits)
BIT_DEPTH=16

# 声道数
CHANNELS=1

# 日志配置
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 是否启用详细日志
VERBOSE_LOGGING=true

# 是否验证音频数据完整性
ENABLE_AUDIO_VALIDATION=true

# 是否在分割后验证结果
ENABLE_SPLIT_VALIDATION=true