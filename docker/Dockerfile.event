FROM dockerproxy.com/library/python:3.10-alpine

# Install minimal runtime dependencies
RUN pip install --no-cache-dir --upgrade pip

WORKDIR /app

# Install exact event handler dependencies
RUN pip install --no-cache-dir \
    redis \
    fastapi \
    uvicorn \
    aiohttp

# Copy required files
COPY event_handler.py task_model.py message_queue.py tus_api_server.py distributed_processor.py audio_splitter.py srt_merger.py callback_service.py ./

# Setup
RUN mkdir -p /logs
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1

CMD ["python", "event_handler.py"]
