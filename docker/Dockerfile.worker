# ===== ASR WORKER (CPU-only - No GPU needed) =====
FROM python:3.10-slim

# Install minimal system dependencies
RUN apt-get update -qq && apt-get install -qq --no-install-recommends \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install NO AI libraries - ASR Worker is just a coordinator
# It delegates actual AI processing to the load balancer
RUN pip install --no-cache-dir --quiet --upgrade pip \
    && pip install --no-cache-dir --quiet \
    redis \
    pydantic \
    requests \
    fastapi \
    aiohttp \
    uvicorn

# Copy ONLY coordinator files (no AI models)
COPY task_model.py message_queue.py asr_worker.py faster_whisper_api.py distributed_processor.py ./

# Setup directories
RUN mkdir -p /data /logs /data/srt_results
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
ENV SRT_STORAGE_DIR=/data/srt_results

# Health check
HEALTHCHECK --interval=60s --timeout=30s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8081/health || 1

CMD ["python", "asr_worker.py"]
