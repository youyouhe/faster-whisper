# ===== OPTIMIZED SINGLE-STAGE FOR CPU SERVICES =====
FROM python:3.10-alpine as cpu-services

# Install minimal runtime dependencies
RUN apk add --no-cache \
    curl \
    && pip install --no-cache-dir --upgrade pip

WORKDIR /app

# Copy and install minimal Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    aiohttp \
    pydantic \
    redis \
    numpy \
    scipy \
    tqdm \
    h11 \
    h2 \
    httpx \
    pydub \
    starlette \
    websockets

# Copy common modules
COPY task_model.py message_queue.py ./

# ===== API SERVER =====
FROM cpu-services as api-server
COPY tus_api_server.py ./
RUN mkdir -p /data /logs
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1
CMD ["python", "tus_api_server.py"]

# ===== TUS SERVER =====
FROM cpu-services as tus-server
COPY tus_server.py load_balancer.py ./
RUN mkdir -p /data/uploads /logs
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:1080/health || exit 1
CMD ["python", "tus_server.py"]

# ===== EVENT HANDLER =====
FROM cpu-services as event-handler
COPY event_handler.py ./
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
CMD ["python", "event_handler.py"]

# ===== CALLBACK SERVICE =====
FROM cpu-services as callback-service
COPY callback_service.py ./
RUN pip install --no-cache-dir aiohttp
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
CMD ["python", "-m", "asyncio", "run", "callback_service.py"]

# ===== ASR WORKER (GPU, minimal expansion) =====
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04 as asr-worker

# Install minimal system deps + Python
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip curl ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3 /usr/bin/python

WORKDIR /app

# Install only GPU-essential packages + core ML libs
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
    torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121 \
    ctranslate2 \
    huggingface-hub \
    tokenizers \
    onnxruntime \
    av \
    faster-whisper \
    redis

# Copy minimal ASR files
COPY task_model.py message_queue.py asr_worker.py faster_whisper_api.py ./

# Setup
RUN mkdir -p /data /logs /data/srt_results
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1

HEALTHCHECK --interval=60s --timeout=30s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8081/health || exit 1

CMD ["python", "asr_worker.py"]