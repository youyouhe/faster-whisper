# ===== DYNAMIC GPU SERVICE SCALING =====
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system dependencies including nvidia-smi for GPU detection
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    build-essential \
    ffmpeg \
    git \
    curl \
    nvidia-utils-535 && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy project files (use custom dockerignore to ensure README.md is included)
COPY --chown=root:root . .

# Make sure the start scripts are executable
RUN chmod +x /app/start_unified_multi_gpu_fixed.sh

# Install Python dependencies
RUN pip install --no-cache-dir --no-deps -e . && \
    pip install --no-cache-dir -r requirements.txt

# Note: Model download is handled at runtime to avoid build-time network issues
# Models will be downloaded when the service first starts

# Expose ports for load balancer and multiple GPU services (multi-instance per GPU)
EXPOSE 5001 5002 5003 5004 5005 5006 5007 5008 5009 5010 5011

# Health check for the main container
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5001/health || exit 1

# Start unified multi-GPU services with fixed architecture
CMD ["/app/start_unified_multi_gpu_fixed.sh"]